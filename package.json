{
    "name": "ag-manager",
    "displayName": "Antigravity-Codex-Claude Monitor",
    "description": "Monitor Antigravity (Gemini, Claude, GPT), OpenAI Codex, and Claude (OAuth) quotas inside Antigravity IDE.",
    "version": "1.7.0",
    "license": "MIT",
    "keywords": [
        "antigravity",
        "quota",
        "gemini",
        "claude",
        "codex",
        "monitor",
        "usage"
    ],
    "publisher": "BiViPi",
    "author": {
        "name": "BiViPi",
        "url": "https://github.com/BiViPi"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/BiViPi/AG-Manager.git"
    },
    "icon": "logo/logo.png",
    "engines": {
        "vscode": "^1.96.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "sqm-explorer",
                    "title": "AG Manager",
                    "icon": "$(dashboard)"
                }
            ]
        },
        "views": {
            "sqm-explorer": [
                {
                    "type": "webview",
                    "id": "sqm.sidebar",
                    "name": "Dashboard"
                }
            ]
        },
        "commands": [
            {
                "command": "sqm.openDashboard",
                "title": "AG Manager: Open Dashboard"
            },
            {
                "command": "sqm.refresh",
                "title": "AG Manager: Refresh Quotas",
                "icon": "$(refresh)"
            },
            {
                "command": "sqm.showLogs",
                "title": "AG Manager: Show Output Logs"
            }
        ],
        "configuration": {
            "title": "AG Manager",
            "properties": {
                "sqm.refreshInterval": {
                    "type": "number",
                    "default": 5,
                    "enum": [
                        1,
                        2,
                        5,
                        10,
                        15,
                        30
                    ],
                    "description": "Auto-refresh interval in minutes (default is 5)"
                },
                "sqm.enableNotifications": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable notifications for low quotas"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "node ./esbuild.js --production",
        "build": "node ./esbuild.js",
        "watch": "node ./esbuild.js --watch",
        "package": "vsce package"
    },
    "devDependencies": {
        "@types/node": "20.x",
        "@types/vscode": "^1.96.0",
        "@vscode/vsce": "^3.2.1",
        "esbuild": "^0.24.0",
        "typescript": "^5.7.2"
    },
    "dependencies": {
        "glob": "^13.0.6"
    }
}